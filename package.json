  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e && npm run audit:prod && npm run scan:secrets",
    "test:e2e": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "scan:secrets": "bash scripts/scan-secrets.sh",
    "test:rls": "bash scripts/test-rls.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
